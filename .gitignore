# ---------------------------------------------------------------- secrets
# API keys (OPENROUTER_API_KEY). Keep .env.example, which has no key, under version control.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# virtual environments
.venv/
venv/
env/

# tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------- runtime artefacts
# Per-setup calibration: measured on each physical arm + camera, regenerated by `calibrate`
config/calibration.json
config/calibration_points.npz

# PDDL problem written by every mission, and planner leftovers
problem.pddl
output.sas
sas_plan
sas_plan.*

# Printed ArUco marker (python -m braccio_ns marker)
marker_*.png

# FF planner binary (optional backend, built locally)
ff

# ---------------------------------------------------------------- firmware
# Arduino CLI / IDE build output
firmware/**/build/
*.elf
*.bin
*.hex
*.uf2

# ---------------------------------------------------------------- editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- lezione_visione
lezione_visione/snapshots/
lezione_visione/*.ply
